{
  "name": "koconv",
  "version": "0.4.0",
  "description": "Korean romanization converter",
  "keywords": [
    "korean",
    "hangul",
    "romanization",
    "dprk"
  ],
  "homepage": "https://korean.mkpo.li/",
  "bugs": {
    "url": "https://github.com/mkpoli/koconv/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mkpoli/koconv.git"
  },
  "license": "MIT",
  "author": "mkpoli <mkpoli@mkpo.li>",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "tsrs",
    "test": "bun test",
    "lint:package": "publint --strict",
    "prepublishOnly": "bun run check && bun test && bun run build && bun run lint:package",
    "bench": "bun bench/convert.ts"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "publint": "0.3.25",
    "tsdown": "0.23.4",
    "tsrs": "0.20.1-ts7.1.0-beta"
  }
}
